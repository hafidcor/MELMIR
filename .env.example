DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
NEXTAUTH_SECRET="supersecret"
NEXTAUTH_URL="http://localhost:3000"

# Cloudflare R2 (almacén de imágenes y archivos de MELMIR)
# Sin estas variables la app funciona igual, pero la subida de archivos
# queda desactivada con un aviso. Nunca pongas valores reales aquí:
# configúralas en Vercel (Settings > Environment Variables) y en tu .env local.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="melmir-archivos"
# URL pública del bucket: dominio r2.dev del bucket o dominio propio
# conectado al bucket. Ejemplo: https://pub-xxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_URL=""
