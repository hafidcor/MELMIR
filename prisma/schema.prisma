// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UnidadMedida {
  L
  ML
  KG
  G
  PZA
  BOTELLA
}

enum TipoMovimientoInsumo {
  COMPRA
  AJUSTE_ENTRADA
  PRODUCCION_CONSUMO
  AJUSTE_SALIDA
  MERMA
}

enum EstadoLote {
  PENDIENTE
  EN_PRODUCCION
  COMPLETADO
  CANCELADO
}

enum EstadoPago {
  PAGADO
  PENDIENTE
}

enum EstadoPedido {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

enum EstadoEtapa {
  PENDIENTE
  EN_CURSO
  HECHA
}

model Insumo {
  id           String   @id @default(cuid())
  codigo       String   @unique
  nombre       String
  categoria    String
  unidadMedida UnidadMedida
  costoUnitario Decimal  @db.Decimal(18, 4)
  stockActual  Decimal  @db.Decimal(18, 4) @default(0)
  stockMinimo  Decimal  @db.Decimal(18, 4) @default(0)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recetaInsumos RecetaInsumo[]
  movimientos   InsumoMovimiento[]
  notasLote     NotaLote[]

  @@map("insumos")
}

model Receta {
  id                  String   @id @default(cuid())
  nombre              String
  estilo              String
  descripcion         String?  @db.Text
  abv                 Decimal? @db.Decimal(5, 2)
  volumenLoteEstimado Decimal? @db.Decimal(18, 2)
  rendimientoBotellas Int
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  recetaInsumos      RecetaInsumo[]
  lotesProduccion    LoteProduccion[]
  productosTerminados ProductoTerminado[]
  ventas             Venta[]
  pedidos            Pedido[]

  @@map("recetas")
}

model RecetaInsumo {
  id                String  @id @default(cuid())
  recetaId          String
  insumoId          String
  cantidadConsumida Decimal @db.Decimal(18, 4)
  observaciones     String?

  receta Receta @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  insumo Insumo @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@unique([recetaId, insumoId])
  @@map("receta_insumos")
}

model InsumoMovimiento {
  id            String              @id @default(cuid())
  insumoId      String
  tipo          TipoMovimientoInsumo
  cantidad      Decimal             @db.Decimal(18, 4)
  costoUnitario Decimal?            @db.Decimal(18, 4)
  total         Decimal?            @db.Decimal(18, 4)
  saldoAfter    Decimal?            @db.Decimal(18, 4)
  referencia    String?
  // Lote al que pertenece el consumo (solo PRODUCCION_CONSUMO).
  // Opcional: los movimientos viejos, registrados antes de este cambio,
  // quedan con el campo vacío y se identifican solo por la referencia.
  loteProduccionId String?
  createdAt     DateTime            @default(now())

  insumo         Insumo          @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  loteProduccion LoteProduccion? @relation(fields: [loteProduccionId], references: [id], onDelete: SetNull)

  @@index([loteProduccionId])
  @@map("insumo_movimientos")
}

model LoteProduccion {
  id                 String      @id @default(cuid())
  codigoLote         String      @unique
  recetaId           String
  fechaPlanificada   DateTime?
  fechaProduccion    DateTime?
  estado             EstadoLote  @default(PENDIENTE)
  botellasEsperadas  Int
  botellasReales     Int         @default(0)
  costoTotalLote     Decimal?    @db.Decimal(18, 4)
  costoUnitarioPieza Decimal?    @db.Decimal(18, 4)
  observaciones      String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  receta            Receta            @relation(fields: [recetaId], references: [id], onDelete: Restrict)
  productoTerminado ProductoTerminado?
  etapas            LoteEtapa[]
  notas             NotaLote[]
  // Consumo real de insumos ligado al lote (PRODUCCION_CONSUMO) y
  // costos adicionales de producción (gas, mano de obra, etc.).
  movimientos       InsumoMovimiento[]
  costosAdicionales CostoAdicionalLote[]

  @@map("lotes_produccion")
}

// Costo adicional de producción de un lote (gas, mano de obra, flete,
// etc.): se captura al completar el lote y se suma a su costo real.
model CostoAdicionalLote {
  id               String   @id @default(cuid())
  loteProduccionId String
  concepto         String
  monto            Decimal  @db.Decimal(18, 4)
  createdAt        DateTime @default(now())

  loteProduccion LoteProduccion @relation(fields: [loteProduccionId], references: [id], onDelete: Cascade)

  @@map("costos_adicionales_lote")
}

model ProductoTerminado {
  id                   String   @id @default(cuid())
  loteProduccionId     String   @unique
  recetaId             String
  fechaIngreso         DateTime @default(now())
  botellasEnStock      Int      @default(0)
  costoRealLote        Decimal  @db.Decimal(18, 4)
  costoUnitarioBotella Decimal  @db.Decimal(18, 4)
  createdAt            DateTime @default(now())

  loteProduccion LoteProduccion @relation(fields: [loteProduccionId], references: [id], onDelete: Cascade)
  receta         Receta         @relation(fields: [recetaId], references: [id], onDelete: Restrict)
  ventas         Venta[]

  @@map("productos_terminados")
}

model Venta {
  id                  String   @id @default(cuid())
  fecha               DateTime @default(now())
  productoTerminadoId String
  recetaId            String
  botellasVendidas    Int
  precioUnitario      Decimal  @db.Decimal(18, 4)
  total               Decimal  @db.Decimal(18, 4)
  cliente             String?
  clienteId           String?
  estadoPago          EstadoPago @default(PAGADO)
  montoPagado         Decimal    @db.Decimal(18, 4) @default(0)
  notas               String?
  createdAt           DateTime @default(now())

  productoTerminado ProductoTerminado @relation(fields: [productoTerminadoId], references: [id], onDelete: Restrict)
  receta            Receta            @relation(fields: [recetaId], references: [id], onDelete: Restrict)
  clienteRel        Cliente?          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  abonos            Abono[]

  @@map("ventas")
}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  telefono  String?
  notas     String?  @db.Text
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ventas  Venta[]
  pedidos Pedido[]

  @@map("clientes")
}

model Abono {
  id        String   @id @default(cuid())
  ventaId   String
  monto     Decimal  @db.Decimal(18, 4)
  fecha     DateTime @default(now())
  notas     String?
  createdAt DateTime @default(now())

  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@map("abonos")
}

model Pedido {
  id               String       @id @default(cuid())
  clienteId        String?
  recetaId         String
  cantidadBotellas Int
  estado           EstadoPedido @default(PENDIENTE)
  fechaPedido      DateTime     @default(now())
  fechaEntrega     DateTime?
  notas            String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  receta  Receta   @relation(fields: [recetaId], references: [id], onDelete: Restrict)

  @@map("pedidos")
}

model LoteEtapa {
  id               String      @id @default(cuid())
  loteProduccionId String
  nombre           String
  orden            Int
  fechaPlaneada    DateTime?
  fechaReal        DateTime?
  // Cuándo empezó la etapa (se registra al pasar a EN_CURSO): sirve
  // para decir cuántos días lleva, por ejemplo, la fermentación.
  fechaInicio      DateTime?
  estado           EstadoEtapa @default(PENDIENTE)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  loteProduccion LoteProduccion @relation(fields: [loteProduccionId], references: [id], onDelete: Cascade)

  @@unique([loteProduccionId, orden])
  @@map("lote_etapas")
}

enum TipoNotaLote {
  NOTA
  PROBLEMA
}

// Nota o incidencia de un lote: texto libre, problema con un
// ingrediente (insumoId) o con una parte del proceso (etapa, nombre
// libre de la etapa). Los problemas se pueden marcar como resueltos.
model NotaLote {
  id               String      @id @default(cuid())
  loteProduccionId String
  tipo             TipoNotaLote @default(NOTA)
  texto            String      @db.Text
  insumoId         String?
  etapa            String?
  resuelto         Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  loteProduccion LoteProduccion @relation(fields: [loteProduccionId], references: [id], onDelete: Cascade)
  insumo         Insumo?        @relation(fields: [insumoId], references: [id], onDelete: SetNull)

  @@index([loteProduccionId])
  @@map("notas_lote")
}

enum EntidadArchivo {
  RECETA
  LOTE
  INSUMO
  VENTA
}

// Archivo guardado en Cloudflare R2 (S3-compatible).
// La entidad se guarda como enum (RECETA/LOTE/INSUMO/VENTA) más el id de
// la entidad, sin relaciones Prisma, para no acoplar el modelo a entidades
// que puedan borrarse: al eliminar una entidad sus archivos quedan
// huérfanos y se pueden limpiar por entidadId.
model Archivo {
  id             String         @id @default(cuid())
  nombreOriginal String
  clave          String         @unique
  url            String
  tipoMime       String
  tamano         Int
  entidad        EntidadArchivo
  entidadId      String
  createdAt      DateTime       @default(now())

  @@index([entidad, entidadId])
  @@map("archivos")
}

enum RolUsuario {
  ADMIN
  OPERADOR
  VENDEDOR
  CONSULTA
}

model Usuario {
  id             String     @id @default(cuid())
  nombre         String
  email          String     @unique
  contrasenaHash String
  rol            RolUsuario @default(CONSULTA)
  activo         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("usuarios")
}
